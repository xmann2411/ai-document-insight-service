# Copy to .env and fill in. Only ANTHROPIC_API_KEY is required.

# --- LLM (Anthropic Claude) ---
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-haiku-4-5
LLM_MAX_TOKENS=600

# --- Retrieval / RAG ---
# embedding = chunk + embed + FAISS search (default, needs requirements-rag.txt)
# full      = send all document text to the LLM (no embedding stack needed)
RETRIEVAL_MODE=embedding
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=900
CHUNK_OVERLAP=150
TOP_K=4

# --- OCR (EasyOCR: image uploads + scanned PDFs) ---
OCR_ENABLED=true
OCR_LANGUAGES=en

# --- Uploads ---
MAX_UPLOAD_MB=25
