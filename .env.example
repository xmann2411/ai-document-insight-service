# Copy to .env. Nothing here is required - the defaults run a free, offline
# local model with no API key.

# --- Question answering backend ---
# local  = DistilBERT SQuAD via onnxruntime (free, offline, no key)  [default]
# claude = Anthropic Claude via API (better answers, needs a key, ~cents)
QA_BACKEND=local

# Only used when QA_BACKEND=claude:
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-haiku-4-5
LLM_MAX_TOKENS=600

# --- Retrieval / RAG ---
# embedding = chunk + embed + FAISS search (default)
# full      = pass all document text to the QA backend (no embeddings)
RETRIEVAL_MODE=embedding
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CHUNK_SIZE=900
CHUNK_OVERLAP=150
TOP_K=4

# --- OCR (Tesseract: image uploads + scanned PDFs) ---
OCR_ENABLED=true
OCR_LANGUAGES=eng

# --- Uploads ---
MAX_UPLOAD_MB=25
