# Copy to .env. Nothing here is required - the defaults run a free, offline
# local model with no API key.

# --- Question answering backend ---
# local      = sentence ranking with the cross-encoder (free, offline)  [default]
# distilbert = DistilBERT SQuAD span extraction via onnxruntime (free, offline)
# claude     = Anthropic Claude via API (rephrased answers, needs a key, ~cents)
QA_BACKEND=local

# Only used when QA_BACKEND=claude:
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-haiku-4-5
LLM_MAX_TOKENS=600

# --- Retrieval / RAG ---
# embedding = chunk + embed + FAISS + cross-encoder rerank (default)
# full      = pass all document text to the QA backend (no embeddings)
RETRIEVAL_MODE=embedding
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANK_ENABLED=true
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
RERANK_CANDIDATES=12
CHUNK_SIZE=900
CHUNK_OVERLAP=150
TOP_K=4

# --- OCR (Tesseract: image uploads + scanned PDFs) ---
OCR_ENABLED=true
OCR_LANGUAGES=eng

# --- Uploads ---
MAX_UPLOAD_MB=25
